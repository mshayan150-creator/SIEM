# External hardened dependency deployment example. Local Compose uses generated .env.local.
SIEM_REDIS_URL=rediss://siem:REPLACE@redis.internal:6379/0
SIEM_ELASTICSEARCH_URL=https://elasticsearch.internal:9200
SIEM_ELASTICSEARCH_API_KEY=REPLACE_WITH_SCOPED_API_KEY
SIEM_WEBHOOK_URL=https://soar.internal/api/incidents
SIEM_WEBHOOK_SIGNING_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_32_CHARS
SIEM_PUBLIC_ORIGIN=https://siem.example.org
SIEM_IDENTITY_DB_PATH=/data/identities.sqlite3
SIEM_ALLOW_INSECURE_LOCAL=false
# SIEM_CA_CERTS=/run/secrets/elasticsearch-ca.pem
# SIEM_LOGIN_ACTIONS=["user_login","login","logon"]
# Create accounts with ops.admin; enroll collectors with the admin UI.
# SIEM_INGEST_API_KEY / SIEM_DASHBOARD_API_KEY are deprecated and grant no access.
