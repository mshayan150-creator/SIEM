{
  "index_patterns": [
    "siem-security-alerts"
  ],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "id": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "severity": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "rule_id": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "title": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "description": {
          "type": "text"
        },
        "threat": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "tactic": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "technique": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "affected_asset": {
          "type": "flattened"
        },
        "evidence": {
          "type": "object",
          "enabled": false
        },
        "evidence_count": {
          "type": "integer"
        }
      }
    }
  }
}
